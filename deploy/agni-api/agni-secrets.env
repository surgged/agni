# PLACEHOLDER — this file is overwritten by scripts/e2e-k3s.sh from .env.
# Do not commit real secrets here. These values are intentionally invalid so
# that a bare `kubectl apply -k deploy/agni-api` fails fast instead of
# deploying with dummy credentials.
DATABASE_DSN=postgres://agni:REPLACE_ME@REPLACE_ME:5432/agni?sslmode=disable
REDIS_ADDR=REPLACE_ME:6379
REDIS_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
RESEND_API_KEY=REPLACE_ME
AGNI_S3_ACCESS_KEY=REPLACE_ME
AGNI_S3_SECRET_KEY=REPLACE_ME
AGNI_REGISTRY_USERNAME=REPLACE_ME
AGNI_REGISTRY_PASSWORD=REPLACE_ME
TEMPORAL_HOST_PORT=host.k3d.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agni-deploy
