# Copy to .env and fill in real values. The .env file is git-ignored.
# Only secrets belong here — all other settings live in configs/config.yaml.

DATABASE_DSN=postgres://user:password@127.0.0.1:5432/agni?sslmode=disable

JWT_SECRET=change-me-in-production

REDIS_PASSWORD=

AGNI_S3_ACCESS_KEY=
AGNI_S3_SECRET_KEY=

# Optional: OCI registry credentials (leave empty if unauthenticated)
AGNI_REGISTRY_USERNAME=
AGNI_REGISTRY_PASSWORD=

RESEND_API_KEY=

# --- Optional overrides for scripts/e2e-k3s.sh ---
# AGNI_REGISTRY_URL=zoteg.anurag.store        # overrides registry.url from configs/config.yaml
# AGNI_DOMAIN=agni.indralab.xyz               # overrides share.domain from configs/config.yaml
